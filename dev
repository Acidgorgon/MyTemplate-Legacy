#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File ./tools/dev.ps1 "$@"
fi
if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/dev.ps1 "$@"
fi
echo "PowerShell is required for ./dev (pwsh). https://aka.ms/powershell" >&2
exit 1
