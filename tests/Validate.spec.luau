local Validate = require("../src/shared/Data/Validate")
local V = Validate

return function(t)
	t.test("formats paths", function()
		t.equal(V.FormatPath({}), "<root>")
		t.equal(V.FormatPath({ "Inventory", "Items", 3, "Count" }), "Inventory.Items[3].Count")
		t.equal(V.FormatPath({ "Map", "has space" }), 'Map["has space"]')
		t.equal(V.FormatPath({ "Odd", true :: any }), "Odd[true]")
	end)

	t.test("reports the full path of a nested issue", function()
		local Item = V.Record({ Id = V.String(64, 1), Count = V.Integer(1, 99) })
		local Data = V.Record({ Inventory = V.Record({ Items = V.Array(Item) }) })
		local value = {
			Inventory = {
				Items = { { Id = "a", Count = 1 }, { Id = "b", Count = 2 }, { Id = "c", Count = 1.5 } },
			},
		}
		local ok, err = V.Check(Data, value)
		t.falsy(ok)
		t.equal(err, "Inventory.Items[3].Count: expected integer, got 1.5")
	end)

	t.test("numbers reject NaN and infinity", function()
		local n = V.Number()
		t.truthy(V.Check(n, 1.5))
		t.falsy(V.Check(n, 0 / 0))
		t.falsy(V.Check(n, math.huge))
		t.falsy(V.Check(n, -math.huge))
		t.falsy(V.Check(n, "1"))
	end)

	t.test("number and integer ranges", function()
		t.truthy(V.Check(V.Number(0, 1), 0))
		t.truthy(V.Check(V.Number(0, 1), 1))
		local ok, err = V.Check(V.Number(0, 1), 1.01)
		t.falsy(ok)
		t.contains(err, "must be <= 1")
		t.falsy(V.Check(V.Integer(0), -1))
		t.falsy(V.Check(V.Integer(), 2.5))
		t.falsy(V.Check(V.Integer(), 0 / 0))
		t.truthy(V.Check(V.Integer(1, 10), 10))
	end)

	t.test("strings", function()
		t.truthy(V.Check(V.String(3), "abc"))
		t.falsy(V.Check(V.String(3), "abcd"))
		t.falsy(V.Check(V.String(10, 1), ""))
		t.falsy(V.Check(V.String(), 5))
	end)

	t.test("boolean, enum, literal", function()
		t.truthy(V.Check(V.Boolean, false))
		t.falsy(V.Check(V.Boolean, nil))
		local quality = V.Enum({ "Low", "High" })
		t.truthy(V.Check(quality, "Low"))
		local ok, err = V.Check(quality, "Ultra")
		t.falsy(ok)
		t.contains(err, "expected one of Low, High")
		t.truthy(V.Check(V.Literal(3), 3))
		t.falsy(V.Check(V.Literal(3), 4))
	end)

	t.test("optional, union, custom", function()
		t.truthy(V.Check(V.Optional(V.Integer()), nil))
		t.falsy(V.Check(V.Optional(V.Integer()), 1.5))
		local idOrCount = V.Union(V.String(), V.Integer())
		t.truthy(V.Check(idOrCount, "x"))
		t.truthy(V.Check(idOrCount, 2))
		t.falsy(V.Check(idOrCount, true))
		local even = V.Custom(function(value)
			return type(value) == "number" and value % 2 == 0, "must be even"
		end)
		t.truthy(V.Check(even, 4))
		local ok, err = V.Check(even, 3)
		t.falsy(ok)
		t.equal(err, "<root>: must be even")
	end)

	t.test("arrays: holes, size, stray keys", function()
		local list = V.Array(V.Integer(), 3)
		t.truthy(V.Check(list, {}))
		t.truthy(V.Check(list, { 1, 2, 3 }))

		local issues = V.Issues(list, { 1, 2, 3, 4 })
		t.equal(#issues, 1)
		t.equal(issues[1].Fix, "Truncate")
		t.equal(issues[1].Max, 3)

		issues = V.Issues(list, { [1] = 1, [3] = 3 })
		t.equal(issues[1].Fix, "Compact")

		-- selene: allow(mixed_table)
		issues = V.Issues(list, { 1, foo = 2 })
		t.equal(#issues, 1)
		t.equal(V.FormatIssue(issues[1]), "foo: unexpected key in array")

		t.falsy(V.Check(list, "nope"))
	end)

	t.test("maps: keys, values, size", function()
		local m = V.Map(V.String(5), V.Integer(0), 2)
		t.truthy(V.Check(m, { a = 1, b = 2 }))
		t.falsy(V.Check(m, { a = 1, b = 2, c = 3 }))
		local ok, err = V.Check(m, { toolongkey = 1 })
		t.falsy(ok)
		t.contains(err, "invalid key")
		ok, err = V.Check(m, { a = -1 })
		t.falsy(ok)
		t.equal(err, "a: must be >= 0, got -1")
	end)

	t.test("records: missing fields, extra keys, strict", function()
		local loose = V.Record({ A = V.Integer() })
		t.truthy(V.Check(loose, { A = 1, Extra = true }))
		local ok, err = V.Check(loose, {})
		t.falsy(ok)
		t.equal(err, "A: expected integer, got nil")
		local strict = V.Record({ A = V.Integer() }, true)
		ok, err = V.Check(strict, { A = 1, Extra = true })
		t.falsy(ok)
		t.equal(err, "Extra: unexpected key")
	end)

	t.test("Check counts extra issues", function()
		local r = V.Record({ A = V.Integer(), B = V.Integer(), C = V.Integer() })
		local ok, err = V.Check(r, {})
		t.falsy(ok)
		t.contains(err, "(and 2 more)")
	end)
end
