--!optimize 2
--!native
--!nolint
--!nocheck
-- Generated by Ripple. Do not edit: change the schema and run `ripple` again.
-- Server side: tracked state objects, per-frame delta flush.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local band, bor, lshift = bit32.band, bit32.bor, bit32.lshift
local getmetatable, setmetatable, rawget, rawset, type, typeof, next =
	getmetatable, setmetatable, rawget, rawset, type, typeof, next

local STRUCT, MAP, ARRAY, ANY = 1, 2, 3, 4

--------------------------------------------------------------------------------
-- Writer (one active buffer at a time; per-player writers are loaded/saved)
--------------------------------------------------------------------------------
local buf: buffer = buffer.create(1024)
local pos = 0
local cap = 1024

local function grow(n: number)
	local newCap = math.max(cap * 2, pos + n)
	local nb = buffer.create(newCap)
	buffer.copy(nb, 0, buf, 0, pos)
	buf = nb
	cap = newCap
end

local function wvar(n: number)
	if n < 128 then
		if pos + 1 > cap then
			grow(1)
		end
		buffer.writeu8(buf, pos, n)
		pos += 1
		return
	end
	if pos + 8 > cap then
		grow(8)
	end
	while n >= 128 do
		buffer.writeu8(buf, pos, n % 128 + 128)
		pos += 1
		n = n // 128
	end
	buffer.writeu8(buf, pos, n)
	pos += 1
end

local function wzig(n: number)
	if n >= 0 then
		wvar(n * 2)
	else
		wvar(-n * 2 - 1)
	end
end

local function wstr(s: string)
	local n = #s
	wvar(n)
	if pos + n > cap then
		grow(n)
	end
	buffer.writestring(buf, pos, s)
	pos += n
end

local function wbuf(b: buffer)
	local n = buffer.len(b)
	wvar(n)
	if pos + n > cap then
		grow(n)
	end
	buffer.copy(buf, pos, b, 0, n)
	pos += n
end

local function wenum(map, v)
	if pos + 1 > cap then
		grow(1)
	end
	buffer.writeu8(buf, pos, map[v])
	pos += 1
end

-- Struct field masks for 17..32 fields: count + indices when few fields changed, else 255 + mask.
local function wmask1(w: number, nbytes: number)
	local count = 0
	local x = w
	while x ~= 0 do
		x = band(x, x - 1)
		count += 1
	end
	if count < nbytes then
		if pos + 1 + count > cap then
			grow(1 + count)
		end
		buffer.writeu8(buf, pos, count)
		pos += 1
		x = w
		while x ~= 0 do
			buffer.writeu8(buf, pos, bit32.countrz(x))
			pos += 1
			x = band(x, x - 1)
		end
	else
		if pos + 1 + nbytes > cap then
			grow(1 + nbytes)
		end
		buffer.writeu8(buf, pos, 255)
		pos += 1
		for i = 0, nbytes - 1 do
			buffer.writeu8(buf, pos, band(bit32.rshift(w, i * 8), 255))
			pos += 1
		end
	end
end

local function wmaskN(ws: { number }, nbytes: number)
	local count = 0
	for _, w in ws do
		local x = w
		while x ~= 0 do
			x = band(x, x - 1)
			count += 1
		end
	end
	if count < nbytes then
		if pos + 1 + count > cap then
			grow(1 + count)
		end
		buffer.writeu8(buf, pos, count)
		pos += 1
		for wi, w in ws do
			local x = w
			while x ~= 0 do
				buffer.writeu8(buf, pos, (wi - 1) * 32 + bit32.countrz(x))
				pos += 1
				x = band(x, x - 1)
			end
		end
	else
		if pos + 1 + nbytes > cap then
			grow(1 + nbytes)
		end
		buffer.writeu8(buf, pos, 255)
		pos += 1
		for i = 0, nbytes - 1 do
			local w = ws[i // 4 + 1]
			buffer.writeu8(buf, pos, band(bit32.rshift(w, (i % 4) * 8), 255))
			pos += 1
		end
	end
end

-- Self-describing values for `any` fields.
-- tags: 0 nil, 1 false, 2 true, 3 f64, 4 string, 5 table, 6 Vector3, 7 buffer, 8 uint (varint), 9 negative int (varint)
local wany
function wany(v: any)
	local t = type(v)
	if pos + 1 > cap then
		grow(1)
	end
	if t == "number" then
		if v // 1 == v and v >= -9007199254740991 and v <= 9007199254740991 then
			if v >= 0 then
				buffer.writeu8(buf, pos, 8)
				pos += 1
				wvar(v)
			else
				buffer.writeu8(buf, pos, 9)
				pos += 1
				wvar(-v)
			end
		else
			buffer.writeu8(buf, pos, 3)
			pos += 1
			if pos + 8 > cap then
				grow(8)
			end
			buffer.writef64(buf, pos, v)
			pos += 8
		end
	elseif t == "string" then
		buffer.writeu8(buf, pos, 4)
		pos += 1
		wstr(v)
	elseif t == "boolean" then
		buffer.writeu8(buf, pos, if v then 2 else 1)
		pos += 1
	elseif t == "nil" then
		buffer.writeu8(buf, pos, 0)
		pos += 1
	elseif t == "table" then
		local M = getmetatable(v)
		if M ~= nil and M.D ~= nil then
			v = M.p
		end
		buffer.writeu8(buf, pos, 5)
		pos += 1
		local n = 0
		for _ in v do
			n += 1
		end
		wvar(n)
		for k, x in v do
			wany(k)
			wany(x)
		end
	elseif typeof(v) == "Vector3" then
		buffer.writeu8(buf, pos, 6)
		pos += 1
		if pos + 12 > cap then
			grow(12)
		end
		buffer.writef32(buf, pos, v.X)
		buffer.writef32(buf, pos + 4, v.Y)
		buffer.writef32(buf, pos + 8, v.Z)
		pos += 12
	elseif t == "buffer" then
		buffer.writeu8(buf, pos, 7)
		pos += 1
		wbuf(v)
	else
		error(`Ripple: cannot replicate a value of type {typeof(v)} in an 'any' field`, 0)
	end
end

--------------------------------------------------------------------------------
-- Errors
--------------------------------------------------------------------------------
local function badValue(path: string, want: string, v: any): never
	error(`Ripple: {path} expects {want}, got {typeof(v)} {tostring(v)}`, 3)
end
local function badKey(path: string, want: string, k: any): never
	error(`Ripple: {path} keys must be {want}, got {typeof(k)} {tostring(k)}`, 3)
end
local function badIndex(path: string, k: number, n: number): never
	error(`Ripple: {path} is an array of length {n}; index {k} would leave a hole (use Ripple.insert / Ripple.remove)`, 3)
end
local function badLength(path: string, lo: number, hi: number, n: number): never
	error(`Ripple: {path} must hold {lo}..{hi} items, got {n}`, 3)
end
local function unknownField(path: string, k: any): never
	error(`Ripple: {path} has no field '{tostring(k)}' (add it to the schema)`, 3)
end

--------------------------------------------------------------------------------
-- Tracked nodes
--------------------------------------------------------------------------------
-- A node is a proxy table P (always empty) whose metatable M holds:
--   p      the plain data table (what gets saved; never has a metatable)
--   D      type descriptor            parent/slot  parent node + field index or map key
--   dirty  has unsent changes         w / full     struct: changed-field bits / fields replaced whole
--   dk     map/array/any: changed keys (1 = child patch, 2 = set/removed)
--   V      child proxies (struct: eager, map/array/any: created on first read)
--   ent    root only: the entity
local DIRTY = {}
local ndirty = 0

local warnedDetached = setmetatable({}, { __mode = "k" })

local function childDirty(parent, slot)
	local D = parent.D
	local kind = D.kind
	if kind == STRUCT then
		if D.nw == 0 then
			parent.w = bor(parent.w, lshift(1, slot - 1))
		else
			local ws = parent.w
			local i = (slot - 1) // 32 + 1
			ws[i] = bor(ws[i], lshift(1, (slot - 1) % 32))
		end
	else
		local dk = parent.dk
		if dk[slot] == nil then
			dk[slot] = 1
		end
	end
	return parent
end

local markSave, cleanNode

local function touch(M)
	-- M just went from clean to dirty: walk up until an already-dirty ancestor or the root.
	local start = M
	while true do
		M.dirty = true
		local parent = M.parent
		if parent == nil then
			break
		end
		childDirty(parent, M.slot)
		if parent.dirty then
			return
		end
		M = parent
	end
	local saveParent = M.saveParent
	if saveParent ~= nil then
		-- top of a server-only subtree: nothing to send; reset its flags so the next write reports again
		cleanNode(M)
		markSave(saveParent)
		return
	end
	local e = M.ent
	if e ~= nil then
		e.saveDirty = true
		if e.alive and not e.queued then
			e.queued = true
			ndirty += 1
			DIRTY[ndirty] = e
		end
	elseif M.detached and not warnedDetached[M] then
		warnedDetached[M] = true
		warn(
			`Ripple: a write went to a {M.D.path} table that was already replaced or removed from its state; it will not replicate. Re-read it from the state after replacing it.\n{debug.traceback(nil, 3)}`
		)
	end
end

-- A server-only field changed: nothing to send, but the save is dirty.
function markSave(M)
	while M.parent ~= nil do
		M = M.parent
	end
	local e = M.ent
	if e ~= nil then
		e.saveDirty = true
	end
end

local function detach(P)
	local M = getmetatable(P)
	M.parent = nil
	M.detached = true
	M.dirty = false
end

function cleanNode(M)
	if not M.dirty then
		return
	end
	M.dirty = false
	local D = M.D
	if D.kind == STRUCT then
		if D.nw == 0 then
			M.w = 0
		else
			local ws = M.w
			for i = 1, D.nw do
				ws[i] = 0
			end
		end
		M.full = nil
	else
		table.clear(M.dk)
	end
	local V = M.V
	if V ~= nil then
		for _, c in V do
			if type(c) == "table" then
				local cm = getmetatable(c)
				if cm ~= nil and cm.D ~= nil then
					cleanNode(cm)
				end
			end
		end
	end
end

local function deepCopy(t)
	local out = {}
	for k, v in t do
		if type(v) == "table" then
			local M = getmetatable(v)
			out[k] = deepCopy(if M ~= nil and M.D ~= nil then M.p else v)
		else
			out[k] = v
		end
	end
	return out
end

local function newSaveNode(D, plain, saveParent)
	local node = newNode(D, plain, nil, nil)
	getmetatable(node).saveParent = saveParent
	return node
end

local function lenNode(P)
	return #getmetatable(P).p
end

local function iterNode(P)
	local M = getmetatable(P)
	local plain = M.p
	local V = M.V
	if V == nil then
		return next, plain, nil
	end
	return function(_, k)
		local nk, v = next(plain, k)
		if nk ~= nil and type(v) == "table" then
			return nk, V[nk]
		end
		return nk, v
	end, plain, nil
end

local function nodeToString(P)
	return `Ripple<{getmetatable(P).D.path}>`
end

local T_ANY -- descriptor for nested any-tables (set below)

local newNode
function newNode(D, plain, parent, slot)
	local M = {
		p = plain,
		D = D,
		parent = parent,
		slot = slot,
		dirty = false,
		__newindex = D.ni,
		__iter = iterNode,
		__len = lenNode,
		__tostring = nodeToString,
	}
	local kind = D.kind
	if kind == STRUCT then
		if D.nw == 0 then
			M.w = 0
		else
			M.w = table.create(D.nw, 0)
		end
		local kids = D.kids
		if kids ~= nil then
			-- View: a shallow mirror of plain with child proxies in place of tables, so every read is one
			-- metatable hop. Setters keep it in sync.
			local V = table.clone(plain)
			for _, kid in kids do
				local c = plain[kid.name]
				if type(c) == "table" then
					if kid.so then
						local node = newNode(kid.D, c, nil, kid.idx)
						getmetatable(node).saveParent = M
						V[kid.name] = node
					else
						V[kid.name] = newNode(kid.D, c, M, kid.idx)
					end
				end
			end
			M.V = V
			M.__index = V
		else
			M.__index = plain
		end
	else
		M.dk = {}
		local valD = if kind == ANY then T_ANY else D.val
		if valD ~= nil then
			local V = {}
			setmetatable(V, {
				__index = function(_, k)
					local c = plain[k]
					if type(c) == "table" then
						local node = newNode(valD, c, M, k)
						rawset(V, k, node)
						return node
					end
					return c
				end,
			})
			M.V = V
			M.__index = V
		else
			M.__index = plain
		end
	end
	return setmetatable({}, M)
end

-- `any` tables: dynamic maps whose values are any values (tables become nested any-nodes).
-- Leaf values an `any` field can hold (checked on write, so a bad value can never break a flush).
local function anyLeaf(x: any): boolean
	local t = type(x)
	if t == "number" then
		return x == x
	end
	return t == "nil" or t == "boolean" or t == "string" or t == "buffer"
		or (typeof(x) == "Vector3" and x == x)
end
local anyCheck
local function anyCheckAt(v, depth: number)
	local M = getmetatable(v)
	if M ~= nil and M.D ~= nil then
		return deepCopy(M.p)
	end
	if M ~= nil then
		error("Ripple: tables with metatables cannot go in an 'any' field", 4)
	end
	if depth > 32 then
		error("Ripple: 'any' table is nested more than 32 deep (or contains itself)", 4)
	end
	for k, x in v do
		local tk = type(k)
		if (tk ~= "string" and tk ~= "number" and tk ~= "boolean") or k ~= k then
			error(`Ripple: an 'any' table key must be a string, number or boolean, got {typeof(k)}`, 4)
		end
		if type(x) == "table" then
			local c = anyCheckAt(x, depth + 1)
			if c ~= x then
				v[k] = c
			end
		elseif not anyLeaf(x) then
			error(`Ripple: an 'any' field cannot hold {typeof(x)} {tostring(x)}`, 4)
		end
	end
	return v
end
function anyCheck(v)
	if type(v) ~= "table" then
		if not anyLeaf(v) then
			error(`Ripple: an 'any' field cannot hold {typeof(v)} {tostring(v)}`, 3)
		end
		return v
	end
	return anyCheckAt(v, 1)
end

local function anyNewIndex(P, k, v)
	local M = getmetatable(P)
	local tk = type(k)
	if tk ~= "string" and tk ~= "number" and tk ~= "boolean" then
		badKey(M.D.path, "string, number or boolean", k)
	end
	local p = M.p
	local V = M.V
	local old = rawget(V, k)
	if type(v) == "table" then
		v = anyCheck(v)
	elseif not anyLeaf(v) then
		badValue(M.D.path .. "[]", "any (nil, boolean, number, string, buffer, Vector3 or table)", v)
	elseif old == nil and p[k] == v then
		return
	end
	if old ~= nil then
		detach(old)
		rawset(V, k, nil)
	end
	p[k] = v
	M.dk[k] = 2
	if not M.dirty then
		touch(M)
	end
end

local function anyPatch(M)
	M.dirty = false
	local p, dk, V = M.p, M.dk, M.V
	local n = 0
	for _ in dk do
		n += 1
	end
	wvar(n)
	for k, kind in dk do
		wany(k)
		local v = p[k]
		local c = rawget(V, k)
		local cm = if c ~= nil then getmetatable(c) else nil
		if v ~= nil and kind == 1 and cm ~= nil and cm.dirty then
			if pos + 1 > cap then
				grow(1)
			end
			buffer.writeu8(buf, pos, 2)
			pos += 1
			anyPatch(cm)
		else
			if cm ~= nil then
				cleanNode(cm)
			end
			if pos + 1 > cap then
				grow(1)
			end
			buffer.writeu8(buf, pos, if v == nil then 0 else 1)
			pos += 1
			if v ~= nil then
				wany(v)
			end
		end
	end
	table.clear(dk)
end

T_ANY = { kind = ANY, path = "any", ni = anyNewIndex }
T_ANY.full, T_ANY.patch, T_ANY.check = wany, anyPatch, anyCheck

export type PlayerData = { Coins: number }

-- Enums

-- Type descriptors
local T1 = { kind = 1, path = "PlayerData" }
local T1_full, T1_patch, T1_check

T1.nw = 0
T1.names = { "Coins" }
local T1_set = {}
T1_set.Coins = function(M, v)
	if not (type(v) == "number" and v == v) then badValue("PlayerData.Coins", "f64", v) end
	local p = M.p
	if p.Coins ~= v then
		p.Coins = v
		M.w = bor(M.w, 1)
		if not M.dirty then touch(M) end
	end
end
T1.set = T1_set
T1.ni = function(P, k, v)
	local f = T1_set[k]
	if f == nil then unknownField("PlayerData", k) end
	f(getmetatable(P), v)
end
function T1_check(v)
	if type(v) ~= "table" then badValue("PlayerData", "struct", v) end
	local M = getmetatable(v) if M ~= nil and M.D ~= nil then v = deepCopy(M.p) end
	for k in v do if T1_set[k] == nil then unknownField("PlayerData", k) end end
	do local x = v.Coins
		if not (type(x) == "number" and x == x) then badValue("PlayerData.Coins", "f64", x) end
	end
	return v
end
function T1_full(p)
	if pos + 8 > cap then grow(8) end buffer.writef64(buf, pos, p.Coins) pos += 8
end
function T1_patch(M)
	local p = M.p
	M.dirty = false
	local w1 = M.w M.w = 0
	if pos + 1 > cap then grow(1) end buffer.writeu8(buf, pos, w1) pos += 1
	if band(w1, 1) ~= 0 then
		if pos + 8 > cap then grow(8) end buffer.writef64(buf, pos, p.Coins) pos += 8
	end
end
T1.full, T1.patch, T1.check = T1_full, T1_patch, T1_check

-- States
local STATES = { { id = 1, name = "PlayerData", scope = "Player", D = T1 } }
local REMOTE_NAME = "Ripple"

--------------------------------------------------------------------------------
-- Entities, subscribers and the flush
--------------------------------------------------------------------------------
local OP_CREATE, OP_PATCH, OP_DESTROY, OP_BPATCH = 1, 2, 3, 4

local nextId = 0
local ENTITY_OF = setmetatable({}, { __mode = "k" }) -- [proxy] = entity
local SUBS_OF = {} -- [player] = { [entity] = true }
local ALL_SCOPE = {} -- [entity] = true (Scope: All)
local PENDING = {} -- [entity] = true (has pending subscribers)
local LEAVING = {} -- [player] = true while PlayerRemoving runs
local GONE = setmetatable({}, { __mode = "k" }) -- players who left (never send to them again)
local scratch = { buf = buffer.create(1024), pos = 0, cap = 1024 }
-- Private data for this frame: every op is encoded ONCE into `stage`; each player gets a chain of
-- segments (start, length) pointing into it. A patch seen by 10 players is 10 segments, 0 copies.
local STAGE_CAP = 4096
local stage = { buf = buffer.create(STAGE_CAP), pos = 0, cap = STAGE_CAP }
local segS, segL, segNext = {}, {}, {}
local nseg = 0
local HEAD, TAIL = {}, {} -- [player] = first / last segment index
local ORDER = {} -- players with segments, in first-write order
local norder = 0
-- Shared stream: patches of Scope All states, identical for every player, sent once with FireAllClients
-- when nobody has private data this frame.
local bcast = { buf = buffer.create(256), pos = 0, cap = 256 }

local remote: RemoteEvent? = nil
local sendFn: ((Player, buffer) -> ())? = nil
local sendAllFn: ((buffer) -> ())? = nil

local function load(w)
	buf, pos, cap = w.buf, w.pos, w.cap
end
local function save(w)
	w.buf, w.pos, w.cap = buf, pos, cap
end

local function addSeg(player, start: number, len: number)
	nseg += 1
	segS[nseg] = start
	segL[nseg] = len
	segNext[nseg] = 0
	local t = TAIL[player]
	if t == nil then
		HEAD[player] = nseg
		norder += 1
		ORDER[norder] = player
	else
		segNext[t] = nseg
	end
	TAIL[player] = nseg
end

local function entityOf(P, fname: string)
	local e = ENTITY_OF[P]
	if e == nil then
		error(`Ripple.{fname}: expected a state object returned by Ripple.<State>.new`, 3)
	end
	return e
end

local function writeHeader(op: number, id: number)
	if pos + 1 > cap then
		grow(1)
	end
	buffer.writeu8(buf, pos, op)
	pos += 1
	wvar(id)
end

local function addSub(e, player)
	if e.subSet[player] or e.pendSet[player] then
		return
	end
	e.pendSet[player] = true
	table.insert(e.pending, player)
	PENDING[e] = true
	local s = SUBS_OF[player]
	if s == nil then
		s = {}
		SUBS_OF[player] = s
	end
	s[e] = true
end

local function removeSub(e, player)
	if e.pendSet[player] then
		e.pendSet[player] = nil
		local i = table.find(e.pending, player)
		if i then
			table.remove(e.pending, i)
		end
	elseif e.subSet[player] then
		e.subSet[player] = nil
		local i = table.find(e.subs, player)
		if i then
			local subs = e.subs
			subs[i] = subs[#subs]
			subs[#subs] = nil
		end
		if not LEAVING[player] then
			load(stage)
			local start = pos
			writeHeader(OP_DESTROY, e.id)
			local len = pos - start
			save(stage)
			addSeg(player, start, len)
		end
	end
	local s = SUBS_OF[player]
	if s then
		s[e] = nil
	end
end

local function destroyEntity(e)
	if not e.alive then
		return
	end
	e.alive = false
	local subs = table.clone(e.subs)
	for _, player in subs do
		removeSub(e, player)
	end
	for _, player in table.clone(e.pending) do
		removeSub(e, player)
	end
	PENDING[e] = nil
	ALL_SCOPE[e] = nil
	local root = e.root
	root.ent = e -- keep: writes after destroy still mark saveDirty
end

local function newEntity(state, data, owner)
	local D = state.D
	if type(data) ~= "table" then
		error(`Ripple.{state.name}.new: data must be a table, got {typeof(data)}`, 3)
	end
	local M0 = getmetatable(data)
	if M0 ~= nil then
		error(`Ripple.{state.name}.new: data must be a plain table without a metatable`, 3)
	end
	data = D.check(data)
	nextId += 1
	local proxy = newNode(D, data, nil, nil)
	local root = getmetatable(proxy)
	local e = {
		id = nextId,
		state = state,
		D = D,
		root = root,
		owner = owner,
		alive = true,
		queued = false,
		saveDirty = false,
		subs = {},
		subSet = {},
		pending = {},
		pendSet = {},
	}
	root.ent = e
	-- ENTITY_OF is weak-keyed: nothing reachable from `e` may point back at `proxy`, or it never frees
	ENTITY_OF[proxy] = e
	return e, proxy
end

local function flush()
	-- 1. Patches: encode each dirty entity once, copy to every subscriber.
	for i = 1, ndirty do
		local e = DIRTY[i]
		DIRTY[i] = nil
		e.queued = false
		local root = e.root
		if e.alive and root.dirty then
			local subs = e.subs
			local ns = #subs
			if e.broadcast then
				-- length-prefixed so a client that does not hold this state (yet) can skip it
				load(scratch)
				pos = 0
				e.D.patch(root)
				local n = pos
				local sbuf = buf
				save(scratch)
				load(bcast)
				writeHeader(OP_BPATCH, e.id)
				wvar(n)
				if pos + n > cap then
					grow(n)
				end
				buffer.copy(buf, pos, sbuf, 0, n)
				pos += n
				save(bcast)
			else
				load(stage)
				local start = pos
				writeHeader(OP_PATCH, e.id)
				e.D.patch(root)
				local len = pos - start
				save(stage)
				for s = 1, ns do
					addSeg(subs[s], start, len)
				end
			end
		end
	end
	ndirty = 0
	-- 2. Creates: full snapshot once per entity, copied to every new subscriber.
	if next(PENDING) ~= nil then
		for e in PENDING do
			PENDING[e] = nil
			if e.alive and #e.pending > 0 then
				load(stage)
				local start = pos
				writeHeader(OP_CREATE, e.id)
				if pos + 9 > cap then
					grow(9)
				end
				buffer.writeu8(buf, pos, e.state.id)
				pos += 1
				if e.state.scope == "Player" then
					buffer.writef64(buf, pos, e.owner.UserId)
					pos += 8
				end
				e.D.full(e.root.p)
				local len = pos - start
				save(stage)
				for _, player in e.pending do
					e.pendSet[player] = nil
					e.subSet[player] = true
					table.insert(e.subs, player)
					addSeg(player, start, len)
				end
				table.clear(e.pending)
			end
		end
	end
	-- 3. One remote call per player with data; the shared stream rides along (or goes out once to all).
	local nb = bcast.pos
	local shared: buffer? = nil
	if nb > 0 then
		bcast.pos = 0
		shared = buffer.create(nb)
		buffer.copy(shared :: buffer, 0, bcast.buf, 0, nb)
	end
	local anyPrivate = false
	local got = nil -- players whose private buffer already carried the shared stream
	local sbuf = stage.buf
	for k = 1, norder do
		local player = ORDER[k]
		ORDER[k] = nil
		local h = HEAD[player]
		HEAD[player] = nil
		TAIL[player] = nil
		if GONE[player] or LEAVING[player] then
			continue
		end
		anyPrivate = true
		local out
		if segNext[h] == 0 then
			local n = segL[h]
			out = buffer.create(n + nb)
			buffer.copy(out, 0, sbuf, segS[h], n)
			if shared then
				buffer.copy(out, n, shared :: buffer, 0, nb)
			end
		else
			local n = 0
			local i = h
			while i ~= 0 do
				n += segL[i]
				i = segNext[i]
			end
			out = buffer.create(n + nb)
			local o = 0
			i = h
			while i ~= 0 do
				local l = segL[i]
				buffer.copy(out, o, sbuf, segS[i], l)
				o += l
				i = segNext[i]
			end
			if shared then
				buffer.copy(out, o, shared :: buffer, 0, nb)
			end
		end
		if shared then
			if got == nil then
				got = {}
			end
			got[player] = true
		end
		if sendFn then
			sendFn(player, out)
		else
			(remote :: any):FireClient(player, out)
		end
	end
	norder = 0
	nseg = 0
	stage.pos = 0
	if stage.cap > 1048576 then
		-- a burst (many joins at once) grew the stage: give the memory back
		stage.buf = buffer.create(STAGE_CAP)
		stage.cap = STAGE_CAP
	end
	if shared then
		if not anyPrivate and (sendFn == nil or sendAllFn ~= nil) then
			if sendAllFn then
				sendAllFn(shared :: buffer)
			else
				(remote :: any):FireAllClients(shared)
			end
		else
			for _, player in Players:GetPlayers() do
				if got and got[player] then
					continue
				elseif sendFn then
					sendFn(player, shared :: buffer)
				else
					(remote :: any):FireClient(player, shared)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------
local Ripple = {}

for _, state in STATES do
	local api = {}
	if state.scope == "Player" then
		function api.new(player: Player, data)
			if typeof(player) ~= "Instance" or not player:IsA("Player") then
				error(`Ripple.{state.name}.new(player, data): player must be a Player`, 2)
			end
			local e, proxy = newEntity(state, data, player)
			addSub(e, player)
			return proxy
		end
	elseif state.scope == "All" then
		function api.new(data)
			local e, proxy = newEntity(state, data, nil)
			ALL_SCOPE[e] = true
			e.broadcast = true
			for _, player in Players:GetPlayers() do
				addSub(e, player)
			end
			return proxy
		end
	else
		function api.new(data, players: { Player }?)
			local e, proxy = newEntity(state, data, nil)
			if players then
				for _, player in players do
					addSub(e, player)
				end
			end
			return proxy
		end
	end
	Ripple[state.name] = api
end

-- Starts sending `state` to `player` (full snapshot on the next flush).
function Ripple.subscribe(state, player: Player)
	local e = entityOf(state, "subscribe")
	if e.alive then
		addSub(e, player)
	end
end

-- Stops sending `state` to `player`; the client drops its copy.
function Ripple.unsubscribe(state, player: Player)
	local e = entityOf(state, "unsubscribe")
	e.broadcast = false
	ALL_SCOPE[e] = nil
	removeSub(e, player)
end

-- Stops replicating `state` everywhere. The plain data table is untouched (save it as usual).
function Ripple.destroy(state)
	destroyEntity(entityOf(state, "destroy"))
end

-- The plain table behind a state object or any table inside it (what you save).
function Ripple.raw(t)
	local M = getmetatable(t)
	if type(t) ~= "table" or M == nil or M.D == nil then
		error("Ripple.raw: expected a Ripple state table", 2)
	end
	return M.p
end

-- Save helpers: true when a tracked write happened since the last clearDirty (or the state was created).
function Ripple.isDirty(state): boolean
	local e = entityOf(state, "isDirty")
	return e.saveDirty or e.root.dirty or not e.alive
end
function Ripple.clearDirty(state)
	entityOf(state, "clearDirty").saveDirty = false
end

-- Array helpers (table.insert / table.remove bypass the proxy).
function Ripple.insert(arr, posOrValue, value)
	local M = getmetatable(arr)
	if M == nil or M.D == nil or M.D.kind ~= ARRAY then
		error("Ripple.insert: expected a Ripple array", 2)
	end
	local p = M.p
	local v = if value == nil then posOrValue else value
	local at = if value == nil then #p + 1 else posOrValue
	if at == #p + 1 then
		arr[at] = v
		return
	end
	-- shift: validate through the setter on a temporary slot, then move
	arr[#p + 1] = v
	local moved = table.remove(p)
	table.insert(p, at, moved)
	for k, c in M.V or {} do
		detach(c)
		M.V[k] = nil
	end
	M.full = true
	if not M.dirty then
		touch(M)
	end
end

function Ripple.remove(arr, at: number?)
	local M = getmetatable(arr)
	if M == nil or M.D == nil or M.D.kind ~= ARRAY then
		error("Ripple.remove: expected a Ripple array", 2)
	end
	local p = M.p
	local v = table.remove(p, at)
	if at == nil or at == #p + 1 then
		-- removed the last element: a keyed removal is enough
		M.dk[#p + 1] = 2
		local c = M.V and rawget(M.V, #p + 1)
		if c then
			detach(c)
			M.V[#p + 1] = nil
		end
	else
		for k, c in M.V or {} do
			detach(c)
			M.V[k] = nil
		end
		M.full = true
	end
	if not M.dirty then
		touch(M)
	end
	return v
end

-- Sends every pending change now (also runs automatically once per frame on Heartbeat).
Ripple.flush = flush

-- Replace the transport, e.g. to ride on a Current (Blink+) event:
--   Ripple.setTransport(function(player, data) Net.RippleSync.Fire(player, data) end)
-- and on the client call Ripple.receive(data) from that event.
-- `allFn(data)` (optional) sends one buffer to every player (FireAll); without it, shared data goes per player.
function Ripple.setTransport(fn: (Player, buffer) -> (), allFn: ((buffer) -> ())?)
	sendFn = fn
	sendAllFn = allFn
end

local existing = ReplicatedStorage:FindFirstChild(REMOTE_NAME)
if existing then
	remote = existing
else
	local r = Instance.new("RemoteEvent")
	r.Name = REMOTE_NAME
	r.Parent = ReplicatedStorage
	remote = r
end
-- Ripple never reads from clients. A listener that ignores everything keeps Roblox from queueing
-- whatever an exploiter fires at the remote.
remote.OnServerEvent:Connect(function() end)

Players.PlayerAdded:Connect(function(player)
	for e in ALL_SCOPE do
		addSub(e, player)
	end
end)
for _, player in Players:GetPlayers() do
	for e in ALL_SCOPE do
		addSub(e, player)
	end
end

Players.PlayerRemoving:Connect(function(player)
	LEAVING[player] = true
	local s = SUBS_OF[player]
	if s then
		for e in table.clone(s) do
			if e.state.scope == "Player" and e.owner == player then
				destroyEntity(e)
			else
				removeSub(e, player)
			end
		end
	end
	SUBS_OF[player] = nil
	GONE[player] = true
	LEAVING[player] = nil
end)

RunService.Heartbeat:Connect(flush)

return Ripple
