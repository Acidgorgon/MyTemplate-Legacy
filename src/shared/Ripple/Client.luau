--!optimize 2
--!native
--!nolint
--!nocheck
-- Generated by Ripple. Do not edit: change the schema and run `ripple` again.
-- Client side: read-only mirrors of the states this player is subscribed to, plus change listeners.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local band = bit32.band

--------------------------------------------------------------------------------
-- Reader
--------------------------------------------------------------------------------
local rb: buffer = buffer.create(0)
local rp = 0

local function rvar(): number
	local b = buffer.readu8(rb, rp)
	rp += 1
	if b < 128 then
		return b
	end
	local n, mul = b - 128, 128
	while true do
		b = buffer.readu8(rb, rp)
		rp += 1
		if b < 128 then
			return n + b * mul
		end
		n += (b - 128) * mul
		mul *= 128
	end
end

local function rzig(): number
	local n = rvar()
	if n % 2 == 0 then
		return n // 2
	end
	return -(n + 1) // 2
end

local function rstr(): string
	local n = rvar()
	local s = buffer.readstring(rb, rp, n)
	rp += n
	return s
end

local function rbuf(): buffer
	local n = rvar()
	local b = buffer.create(n)
	buffer.copy(b, 0, rb, rp, n)
	rp += n
	return b
end

local function rmask1(nbytes: number): number
	local c = buffer.readu8(rb, rp)
	rp += 1
	local w = 0
	if c == 255 then
		for i = 0, nbytes - 1 do
			w += buffer.readu8(rb, rp) * 2 ^ (i * 8)
			rp += 1
		end
	else
		for _ = 1, c do
			w += 2 ^ buffer.readu8(rb, rp)
			rp += 1
		end
	end
	return w
end

local function rmaskN(nw: number, nbytes: number): { number }
	local ws = table.create(nw, 0)
	local c = buffer.readu8(rb, rp)
	rp += 1
	if c == 255 then
		for i = 0, nbytes - 1 do
			local wi = i // 4 + 1
			ws[wi] += buffer.readu8(rb, rp) * 2 ^ ((i % 4) * 8)
			rp += 1
		end
	else
		for _ = 1, c do
			local b = buffer.readu8(rb, rp)
			rp += 1
			local wi = b // 32 + 1
			ws[wi] += 2 ^ (b % 32)
		end
	end
	return ws
end

local rany
function rany(): any
	local tag = buffer.readu8(rb, rp)
	rp += 1
	if tag == 8 then
		return rvar()
	elseif tag == 4 then
		return rstr()
	elseif tag == 5 then
		local n = rvar()
		local t = {}
		for _ = 1, n do
			local k = rany()
			t[k] = rany()
		end
		return t
	elseif tag == 2 then
		return true
	elseif tag == 1 then
		return false
	elseif tag == 3 then
		local v = buffer.readf64(rb, rp)
		rp += 8
		return v
	elseif tag == 9 then
		return -rvar()
	elseif tag == 6 then
		local v = Vector3.new(buffer.readf32(rb, rp), buffer.readf32(rb, rp + 4), buffer.readf32(rb, rp + 8))
		rp += 12
		return v
	elseif tag == 7 then
		return rbuf()
	end
	return nil
end

--------------------------------------------------------------------------------
-- Change events (queued while a packet is applied, fired after)
--------------------------------------------------------------------------------
local ANY = newproxy(false) -- listener key for "anything in this table changed"
local LISTEN = setmetatable({}, { __mode = "k" }) -- [table] = { [key | ANY] = { fn } }
local EV = {}
local nev = 0

local function ev(t, k, v, o)
	EV[nev + 1] = t
	EV[nev + 2] = k
	EV[nev + 3] = v
	EV[nev + 4] = o
	nev += 4
end

local anyPatch
function anyPatch(t)
	local L = LISTEN[t]
	local n = rvar()
	for _ = 1, n do
		local k = rany()
		local tag = buffer.readu8(rb, rp)
		rp += 1
		local o = t[k]
		local v
		if tag == 2 then
			v = o
			anyPatch(o)
		elseif tag == 1 then
			v = rany()
		end
		t[k] = v
		if L then
			ev(t, k, v, o)
		end
	end
end

export type PlayerData = { Coins: number }

-- Enums

local T1_full, T1_patch
function T1_full()
	local b, p = rb, rp
	local f1
	f1 = buffer.readf64(b, p) p += 8
	rp = p
	return { Coins = f1 }
end
function T1_patch(t)
	local L = LISTEN[t]
	local b, p = rb, rp
	local w1 = buffer.readu8(b, p) p += 1
	if band(w1, 1) ~= 0 then
		local v
		v = buffer.readf64(b, p) p += 8
		if L then local o = t.Coins t.Coins = v if o ~= v then ev(t, "Coins", v, o) end else t.Coins = v end
	end
	rp = p
end

local STATES = { { id = 1, name = "PlayerData", scope = "Player", full = T1_full, patch = T1_patch } }
local REMOTE_NAME = "Ripple"

--------------------------------------------------------------------------------
-- Entities
--------------------------------------------------------------------------------
local OP_CREATE, OP_PATCH, OP_DESTROY, OP_BPATCH = 1, 2, 3, 4

local ENT = {} -- [id] = { id, state, data, owner }
local BY_STATE = {} -- [state id] = { array of entities }
local ADDED = {} -- [state id] = { fn }
local REMOVED = {} -- [state id] = { fn }
local lifecycle = {} -- queued added/removed callbacks for the packet being applied
local WAITING = {} -- [state id] = { thread }

for _, st in STATES do
	BY_STATE[st.id] = {}
	WAITING[st.id] = {}
end

local function playerOf(uid: number?): Player?
	if uid == nil then
		return nil
	end
	local LocalPlayer = Players.LocalPlayer
	if LocalPlayer and LocalPlayer.UserId == uid then
		return LocalPlayer
	end
	for _, p in Players:GetPlayers() do
		if p.UserId == uid then
			return p
		end
	end
	return nil
end

local function report(err)
	task.spawn(error, err, 0)
end

-- Listener lists are copy-on-write (connect/disconnect build a new list), so firing never copies.
local function fire(fns, ...)
	for _, fn in fns do
		local ok, err = pcall(fn, ...)
		if not ok then
			report(err)
		end
	end
end

local firedAny = {}

local function flushEvents()
	local i = 1
	while i <= nev do
		local t, k, v, o = EV[i], EV[i + 1], EV[i + 2], EV[i + 3]
		EV[i], EV[i + 1], EV[i + 2], EV[i + 3] = nil, nil, nil, nil
		i += 4
		local L = LISTEN[t]
		if L then
			if k ~= nil then
				local fns = L[k]
				if fns then
					fire(fns, v, o)
				end
			end
			local anyFns = L[ANY]
			if anyFns and not firedAny[t] then
				firedAny[t] = true
				fire(anyFns, t)
			end
		end
	end
	nev = 0
	table.clear(firedAny)
end

local function receive(b: buffer)
	rb = b
	rp = 0
	local len = buffer.len(b)
	while rp < len do
		local op = buffer.readu8(rb, rp)
		rp += 1
		local id = rvar()
		if op == OP_PATCH then
			local e = ENT[id]
			if e == nil then
				error(`Ripple: patch for unknown state #{id} (client and server built from different schemas?)`, 0)
			end
			e.state.patch(e.data)
		elseif op == OP_BPATCH then
			local n = rvar()
			local e = ENT[id]
			if e == nil then
				rp += n -- a shared state this client does not hold (yet): skip it
			else
				e.state.patch(e.data)
			end
		elseif op == OP_CREATE then
			local sid = buffer.readu8(rb, rp)
			rp += 1
			local st = STATES[sid]
			local owner = nil
			if st.scope == "Player" then
				owner = buffer.readf64(rb, rp)
				rp += 8
			end
			local data = st.full()
			local e = { id = id, state = st, data = data, owner = owner }
			ENT[id] = e
			table.insert(BY_STATE[sid], e)
			table.insert(lifecycle, e)
			table.insert(lifecycle, true)
		elseif op == OP_DESTROY then
			local e = ENT[id]
			if e then
				ENT[id] = nil
				local list = BY_STATE[e.state.id]
				local i = table.find(list, e)
				if i then
					table.remove(list, i)
				end
				table.insert(lifecycle, e)
				table.insert(lifecycle, false)
			end
		else
			error(`Ripple: corrupt packet (op {op})`, 0)
		end
	end
	if nev > 0 then
		flushEvents()
	end
	if #lifecycle > 0 then
		local list = lifecycle
		lifecycle = {}
		for i = 1, #list, 2 do
			local e, added = list[i], list[i + 1]
			local sid = e.state.id
			local ownerPlayer = playerOf(e.owner)
			if added then
				local fns = ADDED[sid]
				if fns then
					fire(fns, e.data, ownerPlayer)
				end
				local waiting = WAITING[sid]
				if #waiting > 0 then
					WAITING[sid] = {}
					for _, w in waiting do
						task.spawn(w, e)
					end
				end
			else
				local fns = REMOVED[sid]
				if fns then
					fire(fns, e.data, ownerPlayer)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------
local Ripple = {}

local function connect(container, key, fn)
	local list = table.clone(container[key] or {})
	table.insert(list, fn)
	container[key] = list
	local c = { Connected = true }
	function c.Disconnect()
		if c.Connected then
			c.Connected = false
			local cur = container[key]
			local i = cur and table.find(cur, fn)
			if i then
				local nl = table.clone(cur)
				table.remove(nl, i)
				container[key] = if #nl > 0 then nl else nil
			end
		end
	end
	c.Destroy = c.Disconnect
	return c
end

for _, st in STATES do
	local api = {}
	local sid = st.id
	local function find(player: Player?)
		local list = BY_STATE[sid]
		if st.scope == "Player" then
			local uid = (player or Players.LocalPlayer).UserId
			for i = #list, 1, -1 do
				if list[i].owner == uid then
					return list[i]
				end
			end
			return nil
		end
		return list[#list]
	end
	-- The current table (read only), or nil. Scope Player: that player's (default: yours).
	function api.get(player: Player?)
		local e = find(player)
		return if e then e.data else nil
	end
	-- Like get, but waits until it exists.
	function api.wait(player: Player?)
		while true do
			local e = find(player)
			if e then
				return e.data
			end
			local thread = coroutine.running()
			table.insert(WAITING[sid], thread)
			coroutine.yield()
		end
	end
	-- Every table of this state this client holds.
	function api.all()
		local out = {}
		for i, e in BY_STATE[sid] do
			out[i] = e.data
		end
		return out
	end
	-- fn(data, ownerPlayer?) for each existing and future one.
	function api.added(fn)
		for _, e in table.clone(BY_STATE[sid]) do
			task.spawn(fn, e.data, playerOf(e.owner))
		end
		return connect(ADDED, sid, fn)
	end
	-- fn(data, ownerPlayer?) when one is removed (destroyed, unsubscribed).
	function api.removed(fn)
		return connect(REMOVED, sid, fn)
	end
	Ripple[st.name] = api
end

-- Ripple.changed(t, key, fn(new, old)) : fires when t[key] changes (also when a table inside it changes).
-- Ripple.changed(t, fn(t))             : fires once per update that changed anything in t.
-- Returns a connection with :Disconnect().
function Ripple.changed(t, key, fn)
	if type(t) ~= "table" then
		error("Ripple.changed: expected a table from a Ripple state", 2)
	end
	if fn == nil then
		fn = key
		key = ANY
	end
	local L = LISTEN[t]
	if L == nil then
		L = {}
		LISTEN[t] = L
	end
	return connect(L, key, fn)
end

-- Like changed(t, key, fn) but also calls fn(current) right away.
function Ripple.observe(t, key, fn)
	local c = Ripple.changed(t, key, fn)
	task.spawn(fn, t[key], nil)
	return c
end

-- Vide integration: Ripple.useVide(require(path.to.vide)) once, then Ripple.source(t, key) returns a Vide
-- source that follows t[key]. Sources are cached per (t, key).
local vide = nil
local SOURCES = setmetatable({}, { __mode = "k" })
function Ripple.useVide(v)
	vide = v
end
function Ripple.source(t, key)
	if vide == nil then
		error("Ripple.source: call Ripple.useVide(vide) first", 2)
	end
	local byKey = SOURCES[t]
	if byKey == nil then
		byKey = {}
		SOURCES[t] = byKey
	end
	local src = byKey[key]
	if src == nil then
		src = vide.source(t[key])
		byKey[key] = src
		Ripple.changed(t, key, function(v)
			src(v)
		end)
	end
	return src
end

-- Custom transport (e.g. a Current/Blink+ event carrying the buffer): call this with each buffer.
Ripple.receive = receive

task.spawn(function()
	local remote = ReplicatedStorage:WaitForChild(REMOTE_NAME)
	remote.OnClientEvent:Connect(receive)
end)

return Ripple
